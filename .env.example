# Copy to .env for local Azure testing. Never commit .env.
STORAGE_MODE=local
# Required when STORAGE_MODE=azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_TABLE_NAME=HoukagoPosts
AZURE_BLOB_CONTAINER=post-images
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
# Set to 1 on HTTPS Azure App Service only
COOKIE_SECURE=0
